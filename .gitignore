# Python 가상환경 (새 환경에서 requirements.txt로 재생성)
terring/

# Python 캐시
__pycache__/
*.pyc

# 데이터 이미지 — USB로 별도 관리 (README 참고)
# 라벨(CSV/JSON)과 체크포인트(.pt)는 git에 포함
*.jpg
*.jpeg

# 재분할 이전 백업 (로컬 보관)
backup_before_resplit/

# 라벨 백업본
*.bak*

# OS
Thumbs.db
.DS_Store

# exe 빌드 (app/build_exe.py) — 빌드 환경과 산출물은 로컬 보관
.venv_build/
build/
dist/

# exe 샘플 사진은 포함 (review.html 카드에서 잘라낸 테스트용 이미지)
!app/sample/*.jpg
